	"..SLLLLLLLLDDLLLDS....",
	"...SLLLLDDLLLLDDS.....",
	"....SLDDLLLLDDS.......",
	".....SSLLLLSS....S....",
	".......SSSS.....SLS...",
	"...SS...SDLSS.SSLDS...",
	"..SLDS.SLDLLSSLDS.S...",
	"...SLLSLDLLDLLS.......",
	"....SSLDLDLLDS........",
